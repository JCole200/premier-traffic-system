    "next": "16.1.4",
    "nodemailer": "^7.0.13",
    "react": "19.2.3",
    "react-big-calendar": "^1.19.4",
    "react-dom": "19.2.3",
    "vercel": "^50.25.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.9",
    "@types/react": "^19",
    "@types/react-big-calendar": "^1.16.3",
    "@types/react-dom": "^19",
    "encoding": "^0.1.13",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "prisma": "^5.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5"
